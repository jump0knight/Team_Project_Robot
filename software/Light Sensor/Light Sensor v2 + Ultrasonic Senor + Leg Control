import machine
import time
import uasyncio as asyncio
from machine import Pin, I2C, time_pulse_us
import leg
import math

front_distance = 0
back_distance = 0


uart = machine.UART(1, baudrate=115200, tx=machine.Pin(4), rx=machine.Pin(5))


gy30_addr = 0x23
i2c = I2C(0, scl=Pin(13), sda=Pin(12), freq=400_000)

DARK_THRESHOLD = 50
BRIGHT_THRESHOLD = 300
stop_due_to_light = False

def Gy_30_Init():
    try:
        i2c.writeto(gy30_addr, bytes([0x01]))  # Power ON
        i2c.writeto(gy30_addr, bytes([0x07]))  # Reset
        i2c.writeto(gy30_addr, bytes([0x10]))  # Continuous high-res
        print("BH1750 Initialized")
    except Exception as e:
        print(f"Error initializing BH1750: {e}")

def Gy_30():
    try:
        if gy30_addr not in i2c.scan():
            print("BH1750 Not Found!")
            return None
        gy = i2c.readfrom(gy30_addr, 2)
        if len(gy) == 2:
            return float((gy[0] << 8) | gy[1]) / 1.2
        else:
            return None
    except Exception as e:
        print(f"I2C Read Error: {e}")
        return None

async def get_stable_light_reading(samples=5, delay=0.1, retries=3):
    readings = []
    for _ in range(samples):
        for _ in range(retries):
            lux = Gy_30()
            if lux is not None:
                readings.append(lux)
                break
            else:
                print("Failed to get reading, retrying...")
                await asyncio.sleep(delay)
        await asyncio.sleep(delay)
    return sum(readings) / len(readings) if readings else None

def adjust_thresholds(lux):
    global DARK_THRESHOLD, BRIGHT_THRESHOLD
    if lux < 100:
        DARK_THRESHOLD = 20
        BRIGHT_THRESHOLD = 500
    else:
        DARK_THRESHOLD = 50
        BRIGHT_THRESHOLD = 500
    print(f"Updated thresholds - DARK_THRESHOLD: {DARK_THRESHOLD}, BRIGHT_THRESHOLD: {BRIGHT_THRESHOLD}")

